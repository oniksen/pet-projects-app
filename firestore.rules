rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The owner UID is intentionally stored only in this file.
    // This is a dummy value: replace it with the real Firebase Authentication UID before deploy.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'BWMNkYVutiSpMbd7i4CPnTHRi9z1';
    }

    function isPublicProject(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.visibility == 'public';
    }

    function validProject() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 2000
        && d.visibility in ['public', 'private']
        && d.status in ['idea', 'prototype', 'in_progress', 'launched', 'archived']
        && d.tech is list;
    }

    function validStage() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string
        && d.status in ['planned', 'current', 'done'];
    }

    function validNote() {
      let d = request.resource.data;
      return d.projectId is string && d.projectId.size() > 0
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.body is string && d.body.size() <= 5000
        && d.category in ['plan', 'note', 'idea'];
    }

    function validAbout() {
      let d = request.resource.data;
      return d.headline is string && d.intro is string
        && d.portraitMonogram is string && d.contactEmail is string
        && d.story is list && d.stats is list && d.skills is list && d.principles is list;
    }

    match /projects/{projectId} {
      allow read: if resource.data.visibility == 'public' || isOwner();
      allow create, update: if isOwner() && validProject();
      allow delete: if isOwner();

      match /stages/{stageId} {
        allow read: if isOwner() || isPublicProject(projectId);
        allow create, update: if isOwner() && validStage();
        allow delete: if isOwner();
      }
    }

    match /notes/{noteId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && validNote();
      allow delete: if isOwner();
    }

    match /content/about {
      allow read: if true;
      allow write: if isOwner() && validAbout();
    }

    match /meta/owner {
      allow read, write: if isOwner();
    }
  }
}
