{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "firebase:init-scope": "node scripts/init-firebaserc.mjs",
    "firebase:emulators": "node scripts/firebase-guard.mjs && firebase emulators:start",
    "firebase:create-db": "node scripts/firebase-guard.mjs && firebase --non-interactive firestore:databases:create \"(default)\" --location europe-west3",
    "firebase:deploy:rules": "node scripts/firebase-guard.mjs deploy && firebase deploy --only firestore:rules,firestore:indexes",
    "format": "oxfmt"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "firebase": "^13.2.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.1.0"
  }
}
